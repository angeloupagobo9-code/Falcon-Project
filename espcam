  Serial.begin(115200);
  delay(800);
  Serial.println("\n============================================");
  Serial.println("   FALCON EDGE AI - PROFESSIONAL VERSION");
  Serial.println("============================================");

  if (!SPIFFS.begin(true)) {
    Serial.println("SPIFFS Mount Failed");
  }

  if (!ei_camera_init()) {
    Serial.println("Camera initialization failed!");
  } else {
    Serial.println("Camera initialized successfully");
  }

  connectWiFi();

  server.on("/", handleRoot);
  server.on("/stream", handleStream);
  server.on("/capture", handleCapturedPhoto);
  server.begin();

  timer.setInterval(3000L, sendToBlynk);

  Serial.println("Dashboard ready!");
  Serial.print("Open: http://");
  Serial.println(WiFi.localIP());
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    Blynk.run();
  }
  timer.run();
  server.handleClient();

  static unsigned long lastAI = 0;
  if (millis() - lastAI < 2800) return;
  lastAI = millis();

  snapshot_buf = (uint8_t*)malloc(EI_CAMERA_RAW_FRAME_BUFFER_COLS * EI_CAMERA_RAW_FRAME_BUFFER_ROWS * EI_CAMERA_FRAME_BYTE_SIZE);
  if (!snapshot_buf) return;

  ei::signal_t signal;
  signal.total_length = EI_CLASSIFIER_INPUT_WIDTH * EI_CLASSIFIER_INPUT_HEIGHT;
  signal.get_data = &ei_camera_get_data;

  if (!ei_camera_capture(EI_CLASSIFIER_INPUT_WIDTH, EI_CLASSIFIER_INPUT_HEIGHT, snapshot_buf)) {
    free(snapshot_buf);
    return;
  }

  ei_impulse_result_t result = {0};
  if (run_classifier(&signal, &result, false) != EI_IMPULSE_OK) {
    free(snapshot_buf);
    return;
  }

  // Find best result
  float maxVal = -1.0f;
  int maxIdx = 0;
  String resultsHtml = "";

  for (uint16_t i = 0; i < EI_CLASSIFIER_LABEL_COUNT; i++) {
    float val = result.classification[i].value;
    if (val > maxVal) {
      maxVal = val;
      maxIdx = i;
    }
    int pct = (int)(val * 100.0f);
    resultsHtml += "<div class='pred-item'>";
    resultsHtml += "<div class='pred-header'><span>" + String(ei_classifier_inferencing_categories[i]) + "</span>";
    resultsHtml += "<span class='pct'>" + String(pct) + "%</span></div>";
    resultsHtml += "<div class='bar-bg'><div class='bar-fill' style='width:" + String(pct) + "%'></div></div></div>";
  }

  topLabel = String(ei_classifier_inferencing_categories[maxIdx]);
  topConfidence = maxVal;
  allResultsHtml = resultsHtml;

  int confPct = (int)(topConfidence * 100.0f);
  updateStatus(topLabel, confPct);

  currentAiStatus = topLabel;
  aiConfidenceScore = confPct;

  Serial.printf("AI: %s | Confidence: %d%%\n", topLabel.c_str(), confPct);

  // Auto capture photo on important detection
  String lower = topLabel;
  lower.toLowerCase();
  bool shouldCapture = false;
  String reason = "";

  if (lower.indexOf("flood") >= 0 && confPct >= 45) {
    shouldCapture = true;
    reason = "FLOOD DETECTED";
  } else if (lower.indexOf("rising") >= 0 && confPct >= 45) {
    shouldCapture = true;
    reason = "RISING WATER LEVEL";
  }

  if (shouldCapture && (millis() - lastPhotoMillis > PHOTO_COOLDOWN)) {
    captureAlertPhoto(reason);
    lastPhotoMillis = millis();
  }

  free(snapshot_buf);
}

void updateStatus(String label, int conf) {
  String lower = label;
  lower.toLowerCase();

  if (lower.indexOf("flood") >= 0 && conf >= 40) {
    statusClass = "critical";
    statusText = "FLOOD DETECTED";
    statusNote = "Critical flood condition detected. Immediate attention required!";
  } 
  else if (lower.indexOf("rising") >= 0 && conf >= 40) {
    statusClass = "warning";
    statusText = "RISING WATER LEVEL";
    statusNote = "Water level is rising. Continuous monitoring active.";
  } 
  else {
    statusClass = "normal";
    statusText = "NORMAL CONDITION";
    statusNote = "Water level is stable. No immediate threat detected.";
  }
}

void connectWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  Serial.print("Connecting to WiFi: ");
  Serial.println(WIFI_SSID);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 25) {
    delay(500);
    Serial.print(".");
    attempts++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi Connected!");
    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());
    Blynk.config(BLYNK_AUTH_TOKEN);
    Blynk.connect();
  } else {
    Serial.println("\nWiFi Connection Failed!");
  }
}

void sendToBlynk() {
  if (Blynk.connected()) {
    Blynk.virtualWrite(V13, currentAiStatus);      // AI Detection
    Blynk.virtualWrite(V14, aiConfidenceScore);    // AI Confidence
    Blynk.virtualWrite(V11, currentAiStatus);      // Edge AI Status
    Serial.println("[Blynk] Data sent");
  }
}

void captureAlertPhoto(String reason) {
  camera_fb_t *fb = esp_camera_fb_get();
  if (!fb) return;

  if (SPIFFS.exists("/alert.jpg")) SPIFFS.remove("/alert.jpg");

  File file = SPIFFS.open("/alert.jpg", FILE_WRITE);
  if (file) {
    file.write(fb->buf, fb->len);
    file.close();
    photoCount++;
    photoCaptured = true;
    lastPhotoStatus = reason;
    Serial.println(">>> ALERT PHOTO CAPTURED: " + reason);
  }
  esp_camera_fb_return(fb);
}

void handleStream() {
  WiFiClient client = server.client();
  String response = "HTTP/1.1 200 OK\r\n";
  response += "Content-Type: multipart/x-mixed-replace; boundary=frame\r\n\r\n";
  server.sendContent(response);

  while (client.connected()) {
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) break;

    client.print("--frame\r\n");
    client.print("Content-Type: image/jpeg\r\n\r\n");
    client.write(fb->buf, fb->len);
    client.print("\r\n");
    esp_camera_fb_return(fb);

    if (!client.connected()) break;
    delay(50);
  }
}

void handleCapturedPhoto() {
  if (SPIFFS.exists("/alert.jpg")) {
    File file = SPIFFS.open("/alert.jpg", "r");
    server.streamFile(file, "image/jpeg");
    file.close();
  } else {
    server.send(404, "text/plain", "No alert photo yet");
  }
}

