// ---------- TELEMETRY ----------
float rawDist = NAN;
float filteredDist = NAN;
float distHistory[3] = {NAN, NAN, NAN};
uint8_t distIndex = 0;

float tempC  = NAN;
float humPct = NAN;
unsigned long lastTHMillis = 0;

String rainStat = "--";
String aiStatus = "WAITING";
String systemStatus = "WAITING";
String fusionStatus = "WAIT";

int lastRSSI = 0;
unsigned long packetCount = 0;
unsigned long lastPacketMillis = 0;

uint8_t dangerCount  = 0;
uint8_t aiFloodCount = 0;

uint8_t buzzMode = 0;
bool buzzerOn = false;
unsigned long buzzerToggleTime = 0;

unsigned long lastDisplayPage = 0;
uint8_t displayPage = 0;

// ---------- BUZZER ----------
void buzzerWrite(bool state) {
  digitalWrite(BUZZER_PIN, (state == BUZZER_ACTIVE_HIGH) ? HIGH : LOW);
}

void buzzerBegin() {
  pinMode(BUZZER_PIN, OUTPUT);
  buzzerWrite(false);
}

// ---------- HELPERS ----------
String upperTrim(String s) {
  s.trim();
  s.toUpperCase();
  return s;
}

bool parseFloatStrict(String s, float &out) {
  s.trim();
  if (s.length() == 0) return false;
  char *end = nullptr;
  float v = strtof(s.c_str(), &end);
  if (end == s.c_str() || *end != '\0') return false;
  if (isnan(v) || isinf(v)) return false;
  out = v;
  return true;
}

float median3(float a, float b, float c) {
  if (isnan(a)) return isnan(b) ? c : (isnan(c) ? b : (b < c ? b : c));
  if (isnan(b)) return isnan(c) ? a : (a < c ? a : c);
  if (isnan(c)) return (a < b ? a : b);
  if (a > b) { float t = a; a = b; b = t; }
  if (b > c) { float t = b; b = c; c = t; }
  if (a > b) { float t = a; a = b; b = t; }
  return b;
}

void resetDistanceFilter() {
  for (uint8_t i = 0; i < 3; i++) distHistory[i] = NAN;
  distIndex = 0;
  filteredDist = NAN;
}

void updateDistanceFilter(float d) {
  distHistory[distIndex] = d;
  distIndex = (distIndex + 1) % 3;
  filteredDist = median3(distHistory[0], distHistory[1], distHistory[2]);
}

bool isAI_Flood() {
  return upperTrim(aiStatus).indexOf("FLOOD") >= 0;
}

bool isHeavyRain() {
  return upperTrim(rainStat).indexOf("HEAVY") >= 0;
}

bool waterDanger() {
  return !isnan(filteredDist) && filteredDist <= DANGER_DIST_CM;
}

bool waterWarning() {
  return !isnan(filteredDist) &&
         filteredDist > DANGER_DIST_CM &&
         filteredDist < SAFE_DIST_CM;
}

bool packetFresh() {
  return lastPacketMillis != 0 &&
         (millis() - lastPacketMillis <= PACKET_TIMEOUT_MS);
}

bool thFresh() {
  return packetFresh() && lastTHMillis != 0 &&
         (millis() - lastTHMillis <= TH_STALE_MS) &&
         !isnan(tempC) && !isnan(humPct);
}

// ---------- FUSION ----------
void updateEvidenceCounters() {
  if (waterDanger()) {
    if (dangerCount < CONFIRM_SAMPLES) dangerCount++;
  } else {
    dangerCount = 0;
  }

  if (isAI_Flood()) {
    if (aiFloodCount < CONFIRM_SAMPLES) aiFloodCount++;
  } else {
    aiFloodCount = 0;
  }
}

void updateFusionDecision() {
  if (!packetFresh()) {
    dangerCount = 0;
    aiFloodCount = 0;
    systemStatus = "NO DATA";
    fusionStatus = "LINK LOST";
    return;
  }

  bool wf = waterDanger();
  bool aw = isAI_Flood();

  if (dangerCount >= CONFIRM_SAMPLES && aiFloodCount >= CONFIRM_SAMPLES) {
    systemStatus = "FLOOD";
    fusionStatus = "CONFIRMED";
  }
  else if (aiFloodCount >= CONFIRM_SAMPLES) {
    systemStatus = "FLOOD";
    fusionStatus = "AI CONFIRMED";
  }
  else if (dangerCount >= CONFIRM_SAMPLES) {
    systemStatus = "FLOOD";
    fusionStatus = "WATER CONFIRMED";
  }
  else if (wf && aw) {
    systemStatus = "WARNING";
    fusionStatus = "CONFIRMING";
  }
  else if (wf) {
    systemStatus = "WARNING";
    fusionStatus = "WATER HIGH";
  }
  else if (aw) {
    systemStatus = "WARNING";
    fusionStatus = "AI FLOOD";
  }
  else if (waterWarning()) {
    systemStatus = "WARNING";
    fusionStatus = "RISING";
  }
  else if (isHeavyRain()) {
    systemStatus = "WARNING";
    fusionStatus = "HEAVY RAIN";
  }
  else {
    systemStatus = "SAFE";
    fusionStatus = "NORMAL";
  }
}

// ---------- PARSE ----------
bool parsePayload(const String &data) {
  float newDist = NAN, newT = NAN, newH = NAN;
  String newRain = "", newAI = "";

  int start = 0;
  int len = data.length();

  while (start < len) {
    int commaIdx = data.indexOf(',', start);
    String token;
    if (commaIdx == -1) {
      token = data.substring(start);
      start = len;
    } else {
      token = data.substring(start, commaIdx);
      start = commaIdx + 1;
    }

    token.trim();
    int colonIdx = token.indexOf(':');
    if (colonIdx <= 0) continue;

    String key = upperTrim(token.substring(0, colonIdx));
    String value = token.substring(colonIdx + 1);
    value.trim();

    float f;
    if (key == "D") {
      if (parseFloatStrict(value, f) && f > 0.0f && f < 600.0f) newDist = f;
    }
    else if (key == "T") {
      if (parseFloatStrict(value, f) && f > -20.0f && f < 70.0f) newT = f;
    }
    else if (key == "H") {
      if (parseFloatStrict(value, f) && f >= 0.0f && f <= 100.0f) newH = f;
    }
    else if (key == "R") {
      if (value.length() > 0) newRain = upperTrim(value);
    }
    else if (key == "A") {
      if (value.length() > 0) newAI = upperTrim(value);
    }
  }

  if (isnan(newDist)) {
    Serial.println(F("[WARN] No valid D field"));
    return false;
  }

  // Ignore failed DHT (0,0)
  if (!isnan(newT) && !isnan(newH) && newT == 0.0f && newH == 0.0f) {
    newT = NAN;
    newH = NAN;
  }

  if (!packetFresh()) resetDistanceFilter();

  rawDist = newDist;
  updateDistanceFilter(newDist);

  if (!isnan(newT) && !isnan(newH)) {
    tempC = newT;
    humPct = newH;
    lastTHMillis = millis();
  }

  if (newRain.length()) rainStat = newRain;
  if (newAI.length())   aiStatus = newAI;

  lastPacketMillis = millis();
  updateEvidenceCounters();
  updateFusionDecision();
  return true;
}

// ---------- BUZZER ----------
void updateBuzzer() {
  unsigned long now = millis();
  uint8_t wanted = 0;

  if (systemStatus == "FLOOD") wanted = 2;        // continuous
  else if (systemStatus == "WARNING") wanted = 1; // beeping

  if (wanted != buzzMode) {
    buzzMode = wanted;
    buzzerToggleTime = now;
    buzzerOn = (wanted != 0);
    buzzerWrite(buzzerOn);
    return;
  }

  if (buzzMode == 1 && now - buzzerToggleTime >= WARNING_BEEP_INTERVAL) {
    buzzerOn = !buzzerOn;
    buzzerWrite(buzzerOn);
    buzzerToggleTime = now;
  }
  else if (buzzMode == 2) {
    if (!buzzerOn) {
      buzzerOn = true;
      buzzerWrite(true);
    }
  }
  else if (buzzMode == 0) {
    buzzerWrite(false);
    buzzerOn = false;
  }
}

// ---------- OLED ----------
void drawHeader() {
  u8g2.setFont(u8g2_font_5x7_tf);
  u8g2.setCursor(0, 7);
  u8g2.print("FALCON");
#if USE_BLYNK
  u8g2.setCursor(40, 7);
  if (Blynk.connected()) u8g2.print("B");
  else if (WiFi.status() == WL_CONNECTED) u8g2.print("W");
  else u8g2.print("-");
#endif
  u8g2.setCursor(70, 7);
  u8g2.print(lastRSSI);
  u8g2.print("dBm");
  u8g2.drawHLine(0, 9, 128);
}

void drawStatusBar(const String &text) {
  u8g2.setDrawColor(1);
  u8g2.drawBox(0, 52, 128, 12);
  u8g2.setDrawColor(0);
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.setCursor(2, 61);
  u8g2.print(text);
  u8g2.setDrawColor(1);
}

void updateDisplay() {
  if (millis() - lastDisplayPage >= DISPLAY_PAGE_MS) {
    displayPage = (displayPage + 1) % 2;
    lastDisplayPage = millis();
  }

  bool fresh = packetFresh();
  u8g2.clearBuffer();
  drawHeader();
  u8g2.setFont(u8g2_font_6x10_tf);

  if (displayPage == 0) {
    u8g2.setCursor(0, 19);
    u8g2.print("WATER: ");
    if (!fresh || isnan(filteredDist)) u8g2.print("--");
    else {
      u8g2.print(filteredDist, 1);
      u8g2.print("cm");
    }

    u8g2.setCursor(0, 30);
    u8g2.print("AI: ");
    u8g2.print(fresh ? aiStatus : String("--"));

    u8g2.setCursor(0, 41);
    u8g2.print("RAIN: ");
    u8g2.print(fresh ? rainStat : String("--"));

    drawStatusBar("STATUS: " + systemStatus);
  }
  else {
    u8g2.setCursor(0, 19);
    u8g2.print("TEMP: ");
    if (thFresh()) {
      u8g2.print(tempC, 1);
      u8g2.print("C");
    } else u8g2.print("--");

    u8g2.setCursor(0, 30);
    u8g2.print("HUM: ");
    if (thFresh()) {
      u8g2.print(humPct, 0);
      u8g2.print("%");
    } else u8g2.print("--");

    u8g2.setCursor(0, 41);
    u8g2.print("FUSE: ");
    u8g2.print(fusionStatus);

    drawStatusBar("PKT: " + String(packetCount));
  }

  u8g2.sendBuffer();
}

// ---------- BLYNK / WIFI ----------
#if USE_BLYNK
void wifiBegin() {
  WiFi.disconnect(false);
  if (strlen(pass) == 0) WiFi.begin(ssid);       // open network
  else                   WiFi.begin(ssid, pass); // WPA/WPA2
}

void sendToBlynk() {
  if (WiFi.status() != WL_CONNECTED || !Blynk.connected()) return;

  bool fresh = packetFresh();

  Blynk.virtualWrite(V0, systemStatus);
  Blynk.virtualWrite(V4, systemStatus);
  Blynk.virtualWrite(V6, fresh ? "ONLINE" : "NO DATA");
  Blynk.virtualWrite(V8, lastRSSI);
  Blynk.virtualWrite(V9, packetCount);
  Blynk.virtualWrite(V10, systemStatus == "FLOOD" ? "FLOOD DETECTED" : "NO FLOOD");
  Blynk.virtualWrite(V12, fusionStatus);

  if (fresh) {
    if (!isnan(rawDist)) {
      Blynk.virtualWrite(V1, rawDist);
      Blynk.virtualWrite(V7, rawDist);
    }
    Blynk.virtualWrite(V5, rainStat);
    Blynk.virtualWrite(V11, aiStatus);
  }

  if (thFresh()) {
    Blynk.virtualWrite(V2, tempC);
    Blynk.virtualWrite(V3, humPct);
  }

  // Needs an event with code "flood_danger" in the Blynk template (Events tab)
  static String prev = "";
  if (systemStatus == "FLOOD" && prev != "FLOOD") {
    Blynk.logEvent("flood_danger", "FALCON: FLOOD CONFIRMED");
  }
  prev = systemStatus;
}

void handleBlynk() {
  static unsigned long lastWifiTry = 0;
  static unsigned long lastBlynkTry = 0;
  static unsigned long lastBlynkSend = 0;
  unsigned long now = millis();

  if (WiFi.status() != WL_CONNECTED) {
    if (now - lastWifiTry >= WIFI_RETRY_MS) {
      lastWifiTry = now;
      Serial.println(F("[WiFi] reconnecting..."));
      wifiBegin();
    }
    return;
  }

  if (!Blynk.connected()) {
    if (now - lastBlynkTry >= BLYNK_RETRY_MS) {
      lastBlynkTry = now;
      Serial.println(F("[Blynk] connecting..."));
      Blynk.connect(3000);
    }
    return;
  }

  Blynk.run();

  if (now - lastBlynkSend >= BLYNK_INTERVAL_MS) {
    lastBlynkSend = now;
    sendToBlynk();
  }
}
#endif

// ---------- LORA ----------
bool initLoRa() {
  pinMode(LORA_RST_PIN, OUTPUT);
  digitalWrite(LORA_RST_PIN, HIGH); delay(10);
  digitalWrite(LORA_RST_PIN, LOW);  delay(20);
  digitalWrite(LORA_RST_PIN, HIGH); delay(50);

  LoRa.setPins(LORA_SS_PIN, LORA_RST_PIN, LORA_DIO0_PIN);
  SPI.begin(LORA_SCK_PIN, LORA_MISO_PIN, LORA_MOSI_PIN, LORA_SS_PIN);
  LoRa.setSPIFrequency(2000000);

  if (!LoRa.begin(LORA_BAND)) return false;
  LoRa.setSyncWord(LORA_SYNC_WORD);
  return true;
}

// ---------- SETUP ----------
void setup() {
  Serial.begin(115200);
  delay(300);

  buzzerBegin();

  // Startup beep test
  buzzerWrite(true);  delay(200);
  buzzerWrite(false); delay(150);
  buzzerWrite(true);  delay(200);
  buzzerWrite(false);

  Wire.begin(SDA_PIN, SCL_PIN);
  u8g2.begin();
  u8g2.setContrast(255);

  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_ncenB08_tr);
  u8g2.drawStr(10, 30, "FALCON V3");
  u8g2.sendBuffer();
  delay(800);

  while (!initLoRa()) {
    Serial.println(F("LoRa init failed - check wiring"));
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_6x10_tf);
    u8g2.drawStr(0, 25, "LORA ERROR");
    u8g2.sendBuffer();
    delay(2000);
  }
  Serial.println(F("LoRa OK"));

#if USE_BLYNK
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);

  // Scan to see what the ESP32 can hear (2.4 GHz only)
  Serial.println(F("[WiFi] scanning..."));
  int n = WiFi.scanNetworks();
  bool found = false;
  for (int i = 0; i < n; i++) {
    Serial.printf("  %d: %s (%d dBm) enc=%d\n", i, WiFi.SSID(i).c_str(), WiFi.RSSI(i), (int)WiFi.encryptionType(i));
    if (WiFi.SSID(i) == String(ssid)) found = true;
  }
  WiFi.scanDelete();
  if (!found) Serial.println(F("[WiFi] WARNING: hotspot SSID not found (check name, 2.4 GHz, range)"));

  wifiBegin();
  WiFi.setTxPower(WIFI_POWER_11dBm);   // lower current spikes -> fewer brownout resets

  Serial.print(F("[WiFi] connecting"));
  unsigned long t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 20000) {
    delay(500);
    Serial.print('.');
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print(F("\n[WiFi] OK, IP: "));
    Serial.println(WiFi.localIP());
  } else {
    Serial.println(F("\n[WiFi] FAILED (will keep retrying in loop)"));
  }

  Blynk.config(BLYNK_AUTH_TOKEN);
  if (WiFi.status() == WL_CONNECTED) Blynk.connect(5000);
#endif

  Serial.println(F("FALCON RECEIVER V3 READY"));
  updateDisplay();
}

// ---------- LOOP ----------
void loop() {
#if USE_BLYNK
  handleBlynk();
#endif

  static unsigned long lastFusion = 0;
  if (millis() - lastFusion >= 200) {
    lastFusion = millis();
    updateFusionDecision();
  }

  updateBuzzer();

  int packetSize = LoRa.parsePacket();
  if (packetSize) {
    packetCount++;
    String incomingData;
    while (LoRa.available()) {
      incomingData += (char)LoRa.read();
    }

    lastRSSI = LoRa.packetRssi();
    Serial.println(F("------------------------------------------"));
    Serial.printf("[PACKET #%lu] %s\n", packetCount, incomingData.c_str());
    Serial.printf("RSSI: %d dBm\n", lastRSSI);

    if (incomingData.indexOf(':') >= 0 && parsePayload(incomingData)) {
      Serial.printf("Status: %s | Fuse: %s | Dist: %.1f\n",
                    systemStatus.c_str(), fusionStatus.c_str(), filteredDist);
      updateBuzzer();
      updateDisplay();
#if USE_BLYNK
      sendToBlynk();
#endif
    } else {
      Serial.println(F("[WARN] Invalid packet"));
    }
  }

  static unsigned long lastScreen = 0;
  if (millis() - lastScreen >= DISPLAY_REFRESH_MS) {
    lastScreen = millis();
    updateDisplay();
  }

#if USE_BLYNK
  static unsigned long lastStatus = 0;
  if (millis() - lastStatus >= STATUS_PRINT_MS) {
    lastStatus = millis();
    Serial.printf("[STATUS] WiFi:%s Blynk:%s\n",
                  WiFi.status() == WL_CONNECTED ? "OK" : "DOWN",
                  Blynk.connected() ? "OK" : "DOWN");
  }
#endif

  delay(2);
}
