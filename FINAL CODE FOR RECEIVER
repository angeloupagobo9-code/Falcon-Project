// ---------- WATER THRESHOLDS ----------
const float SAFE_DIST_CM   = 30.0f;
const float DANGER_DIST_CM = 14.0f;
const uint8_t CONFIRM_SAMPLES = 2;

// ---------- TIMERS ----------
const unsigned long WARNING_BEEP_INTERVAL = 700;
const unsigned long PACKET_TIMEOUT_MS     = 10000;
const unsigned long TH_STALE_MS           = 15000;
const unsigned long DISPLAY_PAGE_MS       = 3000;
const unsigned long DISPLAY_REFRESH_MS    = 250;
const unsigned long BLYNK_INTERVAL_MS     = 2000;
const unsigned long WIFI_RETRY_MS         = 15000;
const unsigned long BLYNK_RETRY_MS        = 10000;
const unsigned long STATUS_PRINT_MS       = 5000;

